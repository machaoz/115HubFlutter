app/gui/build/
app/gui/hub_native.dll
app/gui/windows/flutter/ephemeral/
app/gui/linux/flutter/ephemeral/
app/gui/macos/Flutter/ephemeral/
*.g.dart~

# ---- IDE ----
.vscode/
.idea/
*.swp

