#!/usr/bin/env bash
# ============================================================================
# 115HubFlutter 构建编排脚本（lunch）
#
# 用法：
#   ./lunch all                全量编译打包（默认 debug）→ debug/Magnetic115Hub/
#   ./lunch all --release      全量编译打包（release）→ release/Magnetic115Hub/
#   ./lunch all -w             debug 打包跳过 flutter test（快速迭代，见下）
#                              注：-w/--no-test 只对 debug 生效；release 强制跑测试，
#                                  且只跳过 flutter test —— 格式与静态分析是硬门槛，不跳。
#   ./lunch gui                只构建 gui 模块（Flutter，默认 debug）
#   ./lunch gui --release      只构建 gui 模块（release）
#   ./lunch quality            格式 + 分析 + 纯 Dart 护栏 + 非原生测试
#   ./lunch baselib|network|system|native   只构建对应原生模块（自动带依赖）
#   ./lunch clean              清理 .cache/
#   ./lunch distclean          清理 .cache/ debug/ release/
#   ./lunch help               帮助
#
# 工具链策略：MSVC（cl.exe）优先；检测不到时尝试 vswhere+vcvars 导入环境；
# 仍不可用回退 MinGW（仅原生模块可用，Flutter 构建必须 MSVC）。
# 环境变量：HUB_TOOLCHAIN=msvc|mingw 可强制指定。
# ============================================================================
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_DIR="$SCRIPT_DIR"
PROJECT_WIN="$(cygpath -m "$PROJECT_DIR" 2>/dev/null || echo "$PROJECT_DIR")"   # 供 Windows 程序（cmake/flutter）使用

CMAKE_BIN="${CMAKE_BIN:-cmake}"
NINJA_BIN="${NINJA_BIN:-ninja}"
FLUTTER_BIN="${FLUTTER_BIN:-flutter}"

# 国内网络环境默认走 pub 镜像（pub.dev 部分归档走 Google 存储会卡死）；已设外部变量则尊重外部值
export PUB_HOSTED_URL="${PUB_HOSTED_URL:-https://pub.flutter-io.cn}"
export FLUTTER_STORAGE_BASEURL="${FLUTTER_STORAGE_BASEURL:-https://storage.flutter-io.cn}"

APP_DIR="$PROJECT_DIR/app"
GUI_DIR="$APP_DIR/gui"
CACHE_DIR="$PROJECT_DIR/.cache"

C_RED=$'\033[31m'; C_GRN=$'\033[32m'; C_YEL=$'\033[33m'; C_CYN=$'\033[36m'; C_OFF=$'\033[0m'
say()  { printf '%s[lunch]%s %s\n' "$C_CYN" "$C_OFF" "$*"; }
ok()   { printf '%s[ ok ]%s %s\n' "$C_GRN" "$C_OFF" "$*"; }
warn() { printf '%s[warn]%s %s\n' "$C_YEL" "$C_OFF" "$*"; }
fail() { printf '%s[fail]%s %s\n' "$C_RED" "$C_OFF" "$*" >&2; exit 1; }

# ---------------------------------------------------------------------------
# 工具链准备：CL_IN_PATH / MSVC_ENV_OK / TOOLCHAIN 变量
# ---------------------------------------------------------------------------
TOOLCHAIN=""
MSVC_ENV_OK=0

setup_msvc_env() {
  local vswhere="/c/Program Files (x86)/Microsoft Visual Studio/Installer/vswhere.exe"
  [ -f "$vswhere" ] || return 1
  local vsdir
  vsdir=$("$vswhere" -latest -products '*' \
           -requires Microsoft.VisualStudio.Component.VC.Tools.x86.x64 \
           -property installationPath 2>/dev/null | tr -d '\r' | head -1)
  [ -n "$vsdir" ] || return 1
  local vcvars="$vsdir/VC/Auxiliary/Build/vcvarsall.bat"
  [ -f "$vcvars" ] || return 1

  # 导入 MSVC 环境。两个坑：
  #   1) 本机全局设了 MSYS_NO_PATHCONV=1 / MSYS2_ARG_CONV_EXCL=*，cmd //c 不会被转成 /c，
  #      直接在命令行拼 "a.bat && set" 会失败 —— 故先经临时 .bat 包装，再在 subshell 里
  #      临时解除转换限制（用 env -u 同样可行）。
  #   2) 安装路径含空格与括号 (x86)，拼接引号易碎 —— 交给 .bat 内的 call 处理。
  local win_vcvars tmpbat win_bat envout
  win_vcvars=$(cygpath -w "$vcvars")
  tmpbat="${TEMP:-/tmp}/hub_vcvars_$$.bat"
  printf '@echo off\r\ncall "%s" x64 >nul 2>&1\r\nset\r\n' "$win_vcvars" > "$tmpbat"
  win_bat=$(cygpath -w "$tmpbat" 2>/dev/null || echo "$tmpbat")
  envout=$( ( unset MSYS_NO_PATHCONV MSYS2_ARG_CONV_EXCL; cmd //c "$win_bat" ) 2>/dev/null | tr -d '\r' ) || true
  rm -f "$tmpbat"
  [ -n "$envout" ] || return 1

  local k v
  while IFS='=' read -r k v; do
    case "$k" in
      PATH)
        local posix_new
        posix_new=$(cygpath -p "$v" 2>/dev/null || true)
        [ -n "$posix_new" ] && export PATH="$posix_new:$PATH"
        ;;
      INCLUDE|LIB|LIBPATH|WindowsSdkDir|WindowsSDKVersion|VCToolsInstallDir|VCToolsVersion|ExternalIncludePath)
        [ -n "$v" ] && export "$k=$v"
        ;;
    esac
  done <<< "$envout"
  command -v cl >/dev/null 2>&1
}

detect_toolchain() {
  command -v cl >/dev/null 2>&1 && { TOOLCHAIN=msvc; return 0; }
  if [ "${HUB_TOOLCHAIN:-auto}" != "mingw" ]; then
    if setup_msvc_env; then
      command -v cl >/dev/null 2>&1 && { TOOLCHAIN=msvc; MSVC_ENV_OK=1; return 0; }
    fi
  fi
  if command -v gcc >/dev/null 2>&1; then
    TOOLCHAIN=mingw
    warn "MSVC(cl.exe) 不可用，原生模块回退 MinGW(gcc)。Flutter GUI 构建仍需 MSVC。"
    return 0
  fi
  fail "找不到可用 C++ 编译器（cl/gcc）。请安装 VS Build Tools 或 MinGW。"
}

# ---------------------------------------------------------------------------
# 原生构建：lunch_native <Debug|Release> [target]
# ---------------------------------------------------------------------------
lunch_native() {
  local config="$1"
  local target="${2:-all}"
  local bdir="$CACHE_DIR/${config,,}"
  local bdir_win="$PROJECT_WIN/.cache/${config,,}"
  local cmake_args=()

  detect_toolchain

  # 工具链切换会让 CMake 缓存失效（生成器/编译器不匹配会直接报错），自动清理重建
  local stamp="$bdir/.hub_toolchain"
  if [ -f "$stamp" ]; then
    local prev; prev=$(cat "$stamp" 2>/dev/null || echo "")
    if [ "$prev" != "$TOOLCHAIN" ]; then
      warn "工具链由 ${prev:-未知} 切换为 $TOOLCHAIN，清理旧构建缓存 $bdir_win"
      rm -rf "$bdir"
    fi
  fi
  mkdir -p "$bdir"
  printf '%s' "$TOOLCHAIN" > "$stamp"

  if [ "$TOOLCHAIN" = "mingw" ]; then
    cmake_args+=(-DCMAKE_CXX_COMPILER=g++)
  else
    cmake_args+=(-DCMAKE_CXX_COMPILER=cl)
  fi

  say "配置原生构建（$TOOLCHAIN / $config）→ $bdir_win"
  "$CMAKE_BIN" -S "$PROJECT_WIN" -B "$bdir_win" -G Ninja \
    -DCMAKE_BUILD_TYPE="$config" "${cmake_args[@]}"

  say "构建目标：$target"
  "$CMAKE_BIN" --build "$bdir_win" --target "$target"

  # 冒烟：all / hub_native 时连带构建并运行冒烟程序
  if [ "$target" = "all" ] || [ "$target" = "hub_native" ]; then
    "$CMAKE_BIN" --build "$bdir_win" --target hub_native_smoke >/dev/null
    if [ -f "$bdir/hub_native_smoke.exe" ]; then
      say "运行原生冒烟：hub_native_smoke"
      "$bdir/hub_native_smoke.exe"
      ok "原生冒烟通过（hub_native.dll 导出面可用）"
    fi
  fi
  ok "原生构建完成 → $bdir_win"
}

# ---------------------------------------------------------------------------
# Flutter 质量门禁：格式 / 静态分析 / 纯 Dart 护栏 / 非原生测试
# ---------------------------------------------------------------------------
lunch_quality() {
  [ -d "$GUI_DIR" ] || fail "gui 模块不存在：$GUI_DIR"
  command -v "$FLUTTER_BIN" >/dev/null 2>&1 || fail "flutter 不在 PATH"

  say "运行 Flutter 质量门禁"
  (
    cd "$GUI_DIR"
    "$FLUTTER_BIN" pub get
    # 格式门禁：失败就停，但要说明白是「格式未对齐」而非静默中止（否则 all 分支
    # 会在此处断掉，后续 lunch_package 不执行，表现为 debug/ 产物时间不变）。
    if ! dart format --output=none --set-exit-if-changed lib test .tools tool; then
      fail "dart format 校验未通过：上方列出的文件格式未对齐。执行 'dart format lib test .tools tool' 修复后重试。"
    fi
    "$FLUTTER_BIN" analyze
    # 护栏清单唯一数据源（新增护栏只需改那个文件，不必动 lunch / CI）
    # 逐个跑而不用 `xargs` 批量：任一个失败要立刻停，且日志要指名是哪个护栏挂的。
    GUARDS="$GUI_DIR/.tools/guards.txt"
    [ -f "$GUARDS" ] || fail "护栏清单不存在：$GUARDS"
    expected=$(awk '{gsub(/^[ \t]+|[ \t]+$/,"")}
                    $0 != "" && substr($0,1,1) != "#" {n++} END{print n+0}' "$GUARDS")
    ran=0
    while IFS= read -r line || [ -n "$line" ]; do
      g=$(printf '%s' "$line" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')
      case "$g" in ''|'#'*) continue ;; esac
      # 格式校验：非注释行必须是干净的脚本路径。错解码会产生 "# ...tool/x.dart"
      # 这类畸形行 —— 不匹配就中止，绝不允许降级成注释被悄悄略过。
      case "$g" in
        *[!A-Za-z0-9_./-]*) fail "护栏清单格式非法（疑似编码错乱）：[$g]" ;;
        *.dart) ;;
        *) fail "护栏清单格式非法（不是 .dart 脚本）：[$g]" ;;
      esac
      [ -f "$GUI_DIR/$g" ] || fail "护栏清单里的脚本不存在：$g（清单：$GUARDS）"
      say "护栏：$g"
      dart "$g" || fail "护栏失败：$g"
      ran=$((ran + 1))
    done < "$GUARDS"
    # 自维护不变量：实跑数必须等于清单有效行数，差额非零 = 有护栏被静默跳过
    [ "$ran" -eq "$expected" ] \
      || fail "护栏执行数不符：清单 $expected 行，实跑 $ran 个"
    ok "护栏全部通过（$ran / $expected）"
    # 测试门禁：debug 可显式跳过（快速迭代），release 强制跑、不允许跳过。
    # 注意只跳过 flutter test —— 格式与静态分析很快且是硬门槛，不跳过。
    if [ "$NO_TEST" = "1" ] && [ "$MODE" != "release" ]; then
      warn "跳过 flutter test（debug + 已指定 --no-test/-w）。格式/分析/护栏仍已执行。"
    else
      [ "$MODE" = "release" ] && say "release 构建：强制执行 flutter test"
      "$FLUTTER_BIN" test --exclude-tags native
    fi
  )
  ok "Flutter 质量门禁通过"
}

# ---------------------------------------------------------------------------
# Flutter 构建：lunch_gui <debug|release>
# ---------------------------------------------------------------------------
lunch_gui() {
  local mode="$1"   # debug | release
  [ -d "$GUI_DIR" ] || fail "gui 模块不存在：$GUI_DIR（尚未 flutter create）"
  [ -f "$GUI_DIR/pubspec.yaml" ] || fail "$GUI_DIR 下没有 pubspec.yaml"

  command -v "$FLUTTER_BIN" >/dev/null 2>&1 || fail "flutter 不在 PATH"
  lunch_quality

  # 版本信息构建期注入（BuildInfo 读取，避免 UI 侧硬编码）
  # 注意：FLUTTER_VERSION / APP_VERSION 为框架保留键，必须用 HUB_ 前缀
  local fver appver
  fver="$("$FLUTTER_BIN" --version 2>/dev/null | head -1 | awk '{print $2}')"
  [ -n "$fver" ] || fver="未知"
  appver="$(sed -n 's/^version:[[:space:]]*\([0-9][^+[:space:]]*\).*/\1/p' "$GUI_DIR/pubspec.yaml" | head -1)"
  [ -n "$appver" ] || appver="0.0.0"

  say "flutter build windows --$mode（app=$appver flutter=$fver）"
  # 用子 shell 隔离：确保 Flutter 构建跑在干净环境里，不继承 lunch_native 导出的
  # MSVC 变量（INCLUDE/LIB/LIBPATH 等）。跨机器上这些变量若指向与 Flutter 自探测
  # 不同的 VS 实例，会导致 cl.exe 编译失败（MSB6006: CL.exe 退出代码 2）。
  if ! (cd "$GUI_DIR" && env -u INCLUDE -u LIB -u LIBPATH -u CL \
        "$FLUTTER_BIN" build windows "--$mode" \
        --dart-define=HUB_APP_VERSION="$appver" \
        --dart-define=HUB_FLUTTER_VERSION="$fver"); then
    fail "Flutter 构建失败。若报 MSB6006（CL.exe 退出代码 2）等编译异常，多为增量构建状态损坏，
     请先执行 ./lunch clean 后重试；仍失败再删除 $GUI_DIR/build 目录重试。"
  fi
  local runner="$GUI_DIR/build/windows/x64/runner"
  [ "$mode" = "release" ] && runner="$runner/Release" || runner="$runner/Debug"
  [ -d "$runner" ] || fail "flutter 产物目录不存在：$runner"

  local dest="$CACHE_DIR/flutter-$mode"
  rm -rf "$dest"
  mkdir -p "$dest"
  cp -r "$runner/." "$dest/"
  ok "gui 构建完成 → $dest"
}

# ---------------------------------------------------------------------------
# 打包合流：lunch_package <debug|release>
# ---------------------------------------------------------------------------
lunch_package() {
  local mode="$1"
  local config; [ "$mode" = "release" ] && config=Release || config=Debug
  local dest_root="$PROJECT_DIR/$mode"
  local dest="$dest_root/Magnetic115Hub"

  local flutter_dir="$CACHE_DIR/flutter-$mode"
  local native_dir="$CACHE_DIR/${mode,,}"

  [ -d "$flutter_dir" ] || fail "缺少 Flutter 产物（$flutter_dir），请先构建 gui"
  [ -f "$native_dir/hub_native.dll" ] || fail "缺少 hub_native.dll，请先构建 native"

  say "合流打包 → $dest"
  rm -rf "$dest"
  mkdir -p "$dest"
  cp -r "$flutter_dir/." "$dest/"
  cp "$native_dir/hub_native.dll" "$dest/"
  if [ -f "$native_dir/hub_native_smoke.exe" ]; then
    cp "$native_dir/hub_native_smoke.exe" "$dest/"
  fi
  ok "打包完成：$dest"
  echo
  echo "  产物目录：$dest"
  echo "  启动入口：$dest/$(ls "$dest" | grep -i '\.exe$' | grep -vi smoke | head -1)"
}

# ---------------------------------------------------------------------------
# 参数解析
# ---------------------------------------------------------------------------
MODE="debug"
NO_TEST=0
for a in "$@"; do
  case "$a" in
    --release|-r) MODE="release" ;;
    --debug|-d)    MODE="debug" ;;
    # 跳过 flutter test（debug 快速迭代用）。release 构建强制跑，见 lunch_quality。
    --no-test|-w)  NO_TEST=1 ;;
  esac
done

cmd="${1:-help}"
[ $# -eq 0 ] && cmd="all"   # ./lunch 无参等价 ./lunch all
cmd=$(echo "$cmd" | tr '[:upper:]' '[:lower:]')

case "$cmd" in
  all)
    # 子 shell 隔离原生构建：其导入的 MSVC 环境不泄漏给后续 flutter 构建
    ( lunch_native "$( [ "$MODE" = "release" ] && echo Release || echo Debug )" all )
    lunch_gui "$MODE"
    lunch_package "$MODE"
    ok "全量完成（$MODE）"
    ;;
  gui)
    lunch_gui "$MODE"
    ;;
  quality|check|test)
    lunch_quality
    ;;
  baselib|network|system)
    lunch_native "$( [ "$MODE" = "release" ] && echo Release || echo Debug )" "hub_$cmd"
    ;;
  native)
    lunch_native "$( [ "$MODE" = "release" ] && echo Release || echo Debug )" hub_native
    ;;
  package|pack)
    lunch_package "$MODE"
    ;;
  clean)
    rm -rf "$CACHE_DIR"
    # 一并清理 Flutter 构建缓存（build/、.dart_tool 等），用于修复增量构建状态损坏
    # 导致的编译失败（如 MSB6006: CL.exe 退出代码 2）
    if [ -d "$GUI_DIR" ] && command -v "$FLUTTER_BIN" >/dev/null 2>&1; then
      (cd "$GUI_DIR" && "$FLUTTER_BIN" clean >/dev/null 2>&1) || true
      say "已执行 flutter clean（$GUI_DIR）"
    fi
    ok "已清理 $CACHE_DIR + Flutter 构建缓存"
    ;;
  distclean)
    rm -rf "$CACHE_DIR" "$PROJECT_DIR/debug" "$PROJECT_DIR/release"
    if [ -d "$GUI_DIR" ] && command -v "$FLUTTER_BIN" >/dev/null 2>&1; then
      (cd "$GUI_DIR" && "$FLUTTER_BIN" clean >/dev/null 2>&1) || true
    fi
    ok "已清理全部构建产物"
    ;;
  help|-h|--help|"")
    cat <<'EOF'
lunch —— 115HubFlutter 构建编排

  ./lunch all                全量编译打包（默认 debug）→ debug/Magnetic115Hub/
  ./lunch all --release      全量编译打包（release）→ release/Magnetic115Hub/
  ./lunch gui [--release]    只构建 gui（Flutter，构建前自动执行质量门禁）
  ./lunch all -w             debug 打包跳过 flutter test（快速迭代；release 强制跑）
  ./lunch quality            运行格式、静态分析、纯 Dart 护栏与非原生测试
  ./lunch native [--release] 只构建原生模块 + hub_native.dll（含冒烟）
  ./lunch baselib|network|system [--release]   只构建对应原生模块
  ./lunch clean              清理 .cache/ 与 Flutter 构建缓存（build/、.dart_tool）
  ./lunch distclean          清理 .cache/ debug/ release/ 与 Flutter 构建缓存
  ./lunch help               本帮助

环境变量：HUB_TOOLCHAIN=msvc|mingw 强制工具链（默认自动：MSVC 优先，回退 MinGW）
EOF
    ;;
  *)
    fail "未知命令：$cmd（./lunch help 查看用法）"
    ;;
esac
